# Copy to .env on the isolated RiverGit host. Never commit the populated .env.
# Replace image values with verified immutable references (prefer sha256 digests).
RIVERGIT_POSTGRES_IMAGE=
RIVERGIT_FORGEJO_IMAGE=

RIVERGIT_DOMAIN=git.example.invalid
RIVERGIT_ROOT_URL=https://git.example.invalid/
RIVERGIT_SSH_PORT=2222

RIVERGIT_DB_NAME=forgejo
RIVERGIT_DB_USER=forgejo
RIVERGIT_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_UNIQUE_SECRET

FORGEJO_UID=1000
FORGEJO_GID=1000
