# Local RiverCloud development only. Use a unique random value.
RIVER_CLOUD_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Encrypted backup recipient (age public key, e.g. age1...).
# Required only when running scripts/river-cloud/backup-local.sh.
RIVER_CLOUD_AGE_RECIPIENT=REPLACE_WITH_AGE_RECIPIENT

# Private age identity file used only by restore-drill-local.sh. Keep outside Git.
RIVER_CLOUD_AGE_IDENTITY_FILE=/absolute/path/to/age-identity.txt

# Optional local folder for encrypted backup artifacts.
RIVER_CLOUD_BACKUP_DIR=./backups
