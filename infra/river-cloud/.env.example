# Local RiverCloud development only. Use unique, long random values.
RIVER_CLOUD_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
RIVER_CLOUD_API_DB_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD

# Existing identity provider used as the RiverAuth upstream during the transition.
# Keep the current RiverSpend Supabase project active; do not migrate users yet.
RIVERAUTH_ISSUER_URL=https://YOUR_PROJECT.supabase.co
RIVERAUTH_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Encrypted backup recipient (age public key, e.g. age1...).
RIVER_CLOUD_AGE_RECIPIENT=REPLACE_WITH_AGE_RECIPIENT

# Private age identity file used only by restore-drill-local.sh. Keep outside Git.
RIVER_CLOUD_AGE_IDENTITY_FILE=/absolute/path/to/age-identity.txt

# Optional local folder for encrypted backup artifacts.
RIVER_CLOUD_BACKUP_DIR=./backups
