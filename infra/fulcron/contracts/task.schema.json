{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fulcron task contract",
  "type": "object",
  "required": [
    "task_id",
    "created_at",
    "request",
    "scope",
    "status",
    "risk",
    "approval"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "repository",
        "paths"
      ],
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "enum": [
            "local",
            "sandbox",
            "staging",
            "production"
          ]
        }
      }
    },
    "assigned_agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "assigned",
        "running",
        "blocked",
        "review",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "approval": {
      "type": "object",
      "required": [
        "required",
        "approved"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "approved": {
          "type": "boolean"
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "inputs": {
      "type": "array"
    },
    "outputs": {
      "type": "array"
    },
    "audit_events": {
      "type": "array"
    },
    "resource_limits": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_limit": {
          "type": "number",
          "minimum": 0.1
        },
        "network": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": false
}