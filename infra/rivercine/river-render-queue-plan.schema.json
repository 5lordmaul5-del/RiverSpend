{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiverRender Queue Plan",
  "type": "object",
  "required": [
    "schema",
    "jobs"
  ],
  "properties": {
    "schema": {
      "const": "river-render-queue-plan-v1"
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "preset",
          "start",
          "end",
          "priority",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "preset": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "priority": {
            "enum": [
              "Low",
              "Normal",
              "High"
            ]
          },
          "notes": {
            "type": "string"
          },
          "status": {
            "const": "planned"
          }
        }
      }
    }
  }
}